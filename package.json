{
  "name": "@effect-durable-harness/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "spikes/*",
      "tools/oxlint/durable"
    ],
    "catalog": {
      "effect": "4.1.4",
      "@effect/platform-bun": "4.1.4",
      "@effect/platform-node": "4.1.4",
      "@effect/platform-node-shared": "4.1.4",
      "@effect/sql-d1": "4.1.4",
      "@effect/sql-sqlite-do": "4.1.4",
      "@effect/sql-sqlite-node": "4.1.4",
      "@effect/vitest": "4.1.4",
      "@effect/language-service": "0.87.3",
      "@opencode/ai": "2.2.5",
      "alchemy": "2.0.0-beta.87",
      "@alchemy.run/cloudflare": "2.0.0-beta.87",
      "@alchemy.run/domain": "2.0.0-beta.87",
      "@alchemy.run/frontend-frameworks": "2.0.0-beta.87",
      "@cloudflare/workers-types": "^4.20251101.0",
      "@types/bun": "^1.3.11",
      "typescript": "^5.7.3",
      "vitest": "^4.0.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "vite": "8.3.4",
      "@vitejs/plugin-react": "6.1.2",
      "@alchemy.run/docker": "2.0.0-beta.87",
      "@alchemy.run/rivet": "2.0.0-beta.87",
      "@alchemy.run/test": "2.0.0-beta.87",
      "rivetkit": "3.0.0",
      "@alchemy.run/fly": "2.0.0-beta.87"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "tsc -b tsconfig.build.json",
    "pack:local": "bun scripts/pack-local.ts",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun run --filter='*' test",
    "lint": "bun --bun oxlint --report-unused-disable-directives --ignore-pattern '.repos/**' --ignore-pattern '.alchemy/**' --ignore-pattern '**/dist/**'",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "bun run --cwd examples/cloudflare-chat dev",
    "deploy": "bun run --cwd examples/cloudflare-chat deploy",
    "destroy": "bun run --cwd examples/cloudflare-chat destroy",
    "clean": "rm -rf node_modules packages/*/node_modules examples/*/node_modules packages/*/dist packages/*/*.tsbuildinfo .packs examples/*/dist"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "catalog:",
    "oxfmt": "^0.40.0",
    "oxlint": "1.81.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/docker": "catalog:",
    "@alchemy.run/domain": "catalog:",
    "@alchemy.run/fly": "catalog:",
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@alchemy.run/rivet": "catalog:",
    "@alchemy.run/test": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@effect/sql-sqlite-do": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "@alchemy.run/rivet@2.0.0-beta.87": "patches/@alchemy.run%2Frivet@2.0.0-beta.87.patch"
  }
}
